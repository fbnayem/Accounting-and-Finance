{
  "name": "@acct/worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@acct/config": "workspace:*",
    "@acct/contracts": "workspace:*",
    "@acct/database": "workspace:*",
    "@acct/domain": "workspace:*",
    "@acct/ledger": "workspace:*",
    "@acct/subledger": "workspace:*",
    "bullmq": "^5.34.6",
    "ioredis": "^5.4.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
