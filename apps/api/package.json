{
  "name": "@acct/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:unit": "vitest run src/common --passWithNoTests",
    "test:integration": "vitest run src/integration --passWithNoTests"
  },
  "dependencies": {
    "@acct/config": "workspace:*",
    "@acct/contracts": "workspace:*",
    "@acct/database": "workspace:*",
    "@acct/domain": "workspace:*",
    "@acct/ledger": "workspace:*",
    "@acct/banking": "workspace:*",
    "@acct/subledger": "workspace:*",
    "@acct/inventory": "workspace:*",
    "@acct/assets": "workspace:*",
    "@acct/projects": "workspace:*",
    "@aws-sdk/client-s3": "^3.1105.0",
    "@aws-sdk/s3-request-presigner": "^3.1105.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
