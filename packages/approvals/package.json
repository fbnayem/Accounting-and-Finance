    "test:integration": "vitest run src/integration"
  },
  "dependencies": {
    "@acct/config": "workspace:*",
    "@acct/database": "workspace:*",
    "@acct/domain": "workspace:*",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
