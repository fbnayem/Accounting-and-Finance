# Copy to `.env`. `pnpm stack:up` does this automatically on first run.
# Every variable here is validated at boot by @acct/config — an invalid or missing
# required variable fails the process at startup, not at first use.

NODE_ENV=development
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database — PostgreSQL 16 minimum (ADR-0008 §1)
# ---------------------------------------------------------------------------
POSTGRES_USER=acct
POSTGRES_PASSWORD=acct_dev_password
POSTGRES_DB=acct
POSTGRES_PORT=55432

# Two roles, and the difference matters (migration 0025).
#
#   DATABASE_URL      the owner. Migrations, seeding and benchmarks — the paths
#                     ADR-0002 names as legitimately cross-tenant.
#   APP_DATABASE_URL  what the API and worker connect as: `app_runtime`, which is
#                     NOT a superuser and NOT the table owner. A superuser bypasses
#                     row-level security outright, so with the owner here the
#                     ADR-0002 policies would be decorative and a cross-tenant probe
#                     would return every row.
#
# `pnpm db:runtime-role` creates the login role from APP_DATABASE_URL. Pointing both
# at the same role is rejected: `pnpm db:verify` can prove app_runtime is not a
# superuser, but nothing can detect an application that simply used the owner's URL.
DATABASE_URL=postgresql://acct:acct_dev_password@localhost:55432/acct
APP_DATABASE_URL=postgresql://acct_app:acct_app_dev_password@localhost:55432/acct

POSTGRES_TEST_PORT=55433
TEST_DATABASE_URL=postgresql://acct:acct_test_password@localhost:55433/acct_test
# The same split for tests. Fixtures set up several tenants through the owner;
# the isolation tests probe through this one, because a test that proves RLS works
# cannot run as the role RLS does not apply to.
TEST_APP_DATABASE_URL=postgresql://acct_app:acct_app_dev_password@localhost:55433/acct_test

DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=30000
# Posting transactions take row locks (ADR-0004). A lock wait longer than this is
# a bug, not congestion — fail loudly rather than pile up connections.
DATABASE_LOCK_TIMEOUT_MS=5000

# ---------------------------------------------------------------------------
# Redis / queues
# ---------------------------------------------------------------------------
REDIS_PORT=56379
REDIS_URL=redis://localhost:56379

# ---------------------------------------------------------------------------
# Object storage (S3-compatible; MinIO locally)
# ---------------------------------------------------------------------------
S3_ENDPOINT=http://localhost:9100
S3_PORT=9100
S3_CONSOLE_PORT=9101
S3_REGION=us-east-1
S3_BUCKET=acct-files
S3_ACCESS_KEY_ID=acct_minio
S3_SECRET_ACCESS_KEY=acct_minio_password
S3_FORCE_PATH_STYLE=true

# ---------------------------------------------------------------------------
# Applications
# ---------------------------------------------------------------------------
API_PORT=3001
API_BASE_URL=http://localhost:3001
WEB_PORT=3000
WEB_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Minimum 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=development_only_session_secret_change_me_now

# AES-256-GCM key for TOTP secrets (mfa_factors.secret_ciphertext), base64, 32 bytes.
# A TOTP secret is the one credential in the schema that cannot be hashed, because
# verifying a code needs it back. Holding the key outside the database is what makes
# a database dump alone insufficient to mint codes.
# Generate with: openssl rand -base64 32
MFA_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnRfb25seV9tZmFfa2V5XzMyYnl0ZXM=

# Session lifetimes. ADR-0005: access tokens are short-lived and revocation is
# immediate because every request re-reads the session row.
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_ABSOLUTE_TTL_SECONDS=2592000
# How recently MFA must have been satisfied to exercise a high-risk permission
# (ADR-0005 §3). Applies to the 19 permissions the registry flags high-risk.
REAUTH_WINDOW_SECONDS=900

# ---------------------------------------------------------------------------
# Worker
# ---------------------------------------------------------------------------
WORKER_CONCURRENCY=4
# ADR-0009 alert threshold: outbox unpublished age p99 > 60s.
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=100

# ---------------------------------------------------------------------------
# Phase 0 scaffold verification route (POST /_phase0/sample-command).
# Proves exit criteria 3 and 4. Must be false outside development.
# ---------------------------------------------------------------------------
ENABLE_PHASE0_SAMPLE=true
